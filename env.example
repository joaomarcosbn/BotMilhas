# --- Feeds RSS (separados por vírgula). Padrão: categorias específicas ---
# FEED_URLS=https://passageirodeprimeira.com/categorias/promocoes/transferencia-de-pontos/feed/,https://www.melhoresdestinos.com.br/promocoes/milhas/feed/

# --- Filtro de duas camadas (opcional; sobrescreve os padrões do config.py) ---
# PROGRAMS=Livelo,Esfera,Smiles,LATAM,Azul,Itaú
# ACTIONS=bônus,transferência,compra,desconto

MAX_ENTRIES=30
REQUEST_TIMEOUT=15
LOG_LEVEL=INFO

# --- Firebase / Firestore ---
# Use UMA das opções abaixo (JSON tem prioridade sobre PATH).

# Local: caminho do arquivo de credenciais baixado do Firebase Console
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# Render: conteúdo do JSON em base64 (uma linha) ou o JSON puro
# Gere com:  base64 -w0 firebase-credentials.json   (macOS: base64 -i firebase-credentials.json)
# FIREBASE_CREDENTIALS_JSON=

FIRESTORE_COLLECTION=offers

# --- Fase 3 (ainda não usado) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
